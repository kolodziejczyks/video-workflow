{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-workflow",
  "main": "server/index.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [{ "pattern": "cutroom.kolodziejczyks.pl", "custom_domain": true }],
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "video-workflow", "database_id": "52244328-8844-41ed-ac4c-3c0c48cda29d", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "REVIEW_AUDIO", "bucket_name": "cutroom-review-audio" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "falling-thunder-f3eb.cloudflareaccess.com",
    "ACCESS_AUD": "393e8fab50cdf6aa3310b386da2a912c0dbec54dbdb9605663927f0d75e9629d",
    "ALLOWED_EMAILS": "bezawka@gmail.com",
    "DRIVE_INBOX_ID": "1Gnbuq3g6SfZckD7iBWGmRWacWK0vgCnW"
  }
}
